{
    "manifest_version": 2,
    "id": "zabbix_automation",
    "name": "Zabbix Automation",
    "namespace": "ZabbixAutomation",
    "version": "1.0.0",
    "author": "zabbix-automation",
    "description": "Automation tools for bulk host management.",
    "actions": {
        "automation.dashboard": {
            "class": "Dashboard",
            "layout": "layout.htmlpage",
            "view": "automation.dashboard"
        },
        "automation.bulk.hosts": {
            "class": "BulkHosts",
            "layout": "layout.htmlpage",
            "view": "automation.bulk.hosts"
        },
        "automation.bulk.hosts.submit": {
            "class": "BulkHostsSubmit",
            "layout": "layout.javascript"
        },
        "automation.user.alerts": {
            "class": "UserAlerts",
            "layout": "layout.htmlpage",
            "view": "automation.user.alerts"
        }
    }
}
