{
    "manifest_version": 2,
    "id": "zabbix_automation",
    "name": "Zabbix Automation",
    "namespace": "ZabbixAutomation",
    "version": "1.0.0",
    "author": "zabbix-automation",
    "description": "Automation tools for bulk host management, template sync, and maintenance windows.",
    "actions": {
        "automation.dashboard": {
            "class": "Dashboard",
            "layout": "layout.htmlpage",
            "view": "automation.dashboard"
        },
        "automation.bulk.hosts": {
            "class": "BulkHosts",
            "layout": "layout.htmlpage",
            "view": "automation.bulk.hosts"
        },
        "automation.bulk.hosts.submit": {
            "class": "BulkHostsSubmit",
            "layout": "layout.json"
        },
        "automation.templates": {
            "class": "Templates",
            "layout": "layout.htmlpage",
            "view": "automation.templates"
        },
        "automation.templates.export": {
            "class": "TemplatesExport",
            "layout": "layout.json"
        },
        "automation.templates.import": {
            "class": "TemplatesImport",
            "layout": "layout.json"
        },
        "automation.maintenance": {
            "class": "Maintenance",
            "layout": "layout.htmlpage",
            "view": "automation.maintenance"
        },
        "automation.maintenance.submit": {
            "class": "MaintenanceSubmit",
            "layout": "layout.json"
        }
    }
}
